<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github.ifrugal</groupId>
        <artifactId>ifrugal-parent</artifactId>
        <version>1.0.15</version>
    </parent>

    <artifactId>spring-gateway-toolkit</artifactId>
    <version>1.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Spring Gateway Toolkit</name>
    <description>
        A comprehensive Spring Cloud Gateway toolkit providing request/response logging,
        caching, mock API framework (Conman), and OAuth2 security - all configurable via YAML.
    </description>
    <url>https://github.com/iFrugal/gateway</url>

    <scm>
        <connection>scm:git:https://x-access-token:${env.GITHUB_TOKEN}@github.com/iFrugal/gateway.git</connection>
        <developerConnection>scm:git:https://x-access-token:${env.GITHUB_TOKEN}@github.com/iFrugal/gateway.git</developerConnection>
        <url>https://github.com/iFrugal/gateway</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>gateway-core</module>
        <module>gateway-starter</module>
        <module>gateway-app</module>
    </modules>

    <properties>
        <!-- Java baseline -->
        <java.version>25</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Build plugins -->
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>

        <!-- Spring versions -->
        <spring-boot.version>3.5.10</spring-boot.version>
        <spring-cloud.version>2025.0.0</spring-cloud.version>

        <!-- Lombok — 1.18.30 (the version Spring Boot 3.5.x manages) predates
             JDK 22 and fails on JDK 25 with "TypeTag :: UNKNOWN". 1.18.46
             is the first release with native JDK 25 support. -->
        <lombok.version>1.18.46</lombok.version>

        <!-- Library versions -->
        <springdoc-openapi.version>3.0.3</springdoc-openapi.version>
        <lazydevs.version>1.0.46</lazydevs.version>
        <json-schema-validator.version>3.0.2</json-schema-validator.version>

        <!-- JaCoCo — 0.8.12 bundles an ASM that cannot read Java 25 bytecode
             (major version 69) and fails report generation. 0.8.14 was the
             first release with ASM new enough for JDK 25. -->
        <jacoco.version>0.8.14</jacoco.version>

        <!-- SonarCloud -->
        <sonar.organization>ifrugal</sonar.organization>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.projectKey>iFrugal_gateway</sonar.projectKey>
        <sonar.java.coveragePlugin>jacoco</sonar.java.coveragePlugin>
        <sonar.coverage.jacoco.xmlReportPaths>
            ${project.basedir}/gateway-core/target/site/jacoco/jacoco.xml
        </sonar.coverage.jacoco.xmlReportPaths>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud BOM -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Internal modules -->
            <dependency>
                <groupId>com.github.ifrugal</groupId>
                <artifactId>gateway-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.ifrugal</groupId>
                <artifactId>gateway-starter</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Third-party libraries -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
                <version>${springdoc-openapi.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.ifrugal</groupId>
                <artifactId>persistence-utils</artifactId>
                <version>${lazydevs.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.ifrugal</groupId>
                <artifactId>app-building-commons</artifactId>
                <version>${lazydevs.version}</version>
            </dependency>
            <dependency>
                <groupId>com.networknt</groupId>
                <artifactId>json-schema-validator</artifactId>
                <version>${json-schema-validator.version}</version>
            </dependency>

            <!-- Lombok — pin so every module gets the JDK-25-compatible
                 version regardless of what Spring Boot's BOM resolves. -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- Java compiler — pin release target locally rather than inheriting
                 from parent. Wire Lombok in explicitly via annotationProcessorPaths
                 so the JDK-25-compatible version is used during compilation. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <release>${java.version}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- JaCoCo Code Coverage -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven-javadoc-plugin.version}</version>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <failOnError>false</failOnError>
                            <additionalJOptions>
                                <additionalJOption>-Xdoclint:none</additionalJOption>
                            </additionalJOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>

        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
