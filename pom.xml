<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github.ifrugal</groupId>
        <artifactId>ifrugal-parent</artifactId>
        <version>1.0.15</version>
    </parent>

    <artifactId>spring-gateway-toolkit</artifactId>
    <version>1.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Spring Gateway Toolkit</name>
    <description>
        A comprehensive Spring Cloud Gateway toolkit providing request/response logging,
        caching, mock API framework (Conman), and OAuth2 security - all configurable via YAML.
    </description>
    <url>https://github.com/iFrugal/gateway</url>

    <!--
      SCM URLs use the standard HTTPS form WITHOUT an embedded token.

      Auth for the CI release workflow is injected at runtime by:
        1) actions/checkout@v6, which configures an http.extraheader
           credential for github.com using ${{ secrets.GITHUB_TOKEN }}.
        2) An explicit `git remote set-url origin https://x-access-token:…`
           in .github/workflows/release.yml as belt-and-suspenders.

      The maven-release-plugin's git SCM provider therefore authenticates
      successfully when it runs `git push <developerConnection>` against
      this HTTPS URL — git resolves the credential via the configured
      helper / extraheader.

      We deliberately do NOT use `git@github.com:…` (SSH) for
      developerConnection: the CI runner has no SSH key configured.

      We deliberately do NOT embed `${env.GITHUB_TOKEN}` in either URL:
      the published artifact's pom.xml on Maven Central contains these
      strings verbatim (Maven publishes the source POM, not a resolved
      one), so an env-var placeholder ends up as visible noise in the
      Central artifact and becomes a real-token-leak risk if a
      maintainer ever runs `mvn release:perform` locally with the env
      var exported. The previous form (kept until commit before this one)
      was:
        scm:git:https://x-access-token:${env.GITHUB_TOKEN}@github.com/…
    -->
    <scm>
        <connection>scm:git:https://github.com/iFrugal/gateway.git</connection>
        <developerConnection>scm:git:https://github.com/iFrugal/gateway.git</developerConnection>
        <url>https://github.com/iFrugal/gateway</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>gateway-core</module>
        <module>gateway-starter</module>
        <module>gateway-app</module>
    </modules>

    <properties>
        <!-- Java baseline -->
        <java.version>25</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Build plugins -->
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>

        <!-- Spring versions.
             Pinned to the 3.5.x / 2025.0.x line. Spring Boot 4 + Spring Cloud
             2025.1 form a coordinated major upgrade that, on the Gateway side,
             renames spring-cloud-starter-gateway into separate WebFlux and
             WebMVC starters and requires a code-level migration. Track the
             migration as its own focused PR — not as a Dependabot click. -->
        <spring-boot.version>3.5.10</spring-boot.version>
        <spring-cloud.version>2025.0.0</spring-cloud.version>

        <!-- Lombok — 1.18.30 (the version Spring Boot 3.5.x manages) predates
             JDK 22 and fails on JDK 25 with "TypeTag :: UNKNOWN". 1.18.46
             is the first release with native JDK 25 support. -->
        <lombok.version>1.18.46</lombok.version>

        <!-- Library versions.
             springdoc 2.x is the line that targets Spring Boot 3.x; the 3.x
             line targets Spring Boot 4 / Spring Framework 7. Bump when we
             actually move to Spring Boot 4.
             json-schema-validator 1.5.x is the line tested against the
             RequestValidator call sites in this project. 2.x and 3.x change
             the JsonSchema / JsonSchemaFactory / SpecVersionDetector API. -->
        <springdoc-openapi.version>2.9.0</springdoc-openapi.version>
        <lazydevs.version>1.0.46</lazydevs.version>
        <json-schema-validator.version>1.5.9</json-schema-validator.version>

        <!-- JaCoCo — 0.8.12 bundles an ASM that cannot read Java 25 bytecode
             (major version 69) and fails report generation. 0.8.14 was the
             first release with ASM new enough for JDK 25. -->
        <jacoco.version>0.8.14</jacoco.version>

        <!-- JaCoCo coverage gate.
             Set conservatively (40% line + 35% branch) so the gate catches a
             real regression but doesn't fail on the existing baseline. Raise
             over time as the test suite grows. Override per-module via the
             `<jacoco.skip>true</jacoco.skip>` property — gateway-app does this
             because it contains no business logic worth gating. -->
        <jacoco.coverage.line.minimum>0.40</jacoco.coverage.line.minimum>
        <jacoco.coverage.branch.minimum>0.35</jacoco.coverage.branch.minimum>
        <jacoco.skip>false</jacoco.skip>

        <!-- CycloneDX SBOM. Generates target/${artifactId}-${version}-cyclonedx.json
             + .xml during `package` and attaches them as deployed artifacts so
             every Maven Central release ships a Software Bill of Materials.
             1.6 is the latest schema version (OWASP, 2024). -->
        <cyclonedx-maven-plugin.version>2.9.1</cyclonedx-maven-plugin.version>
        <cyclonedx.schema.version>1.6</cyclonedx.schema.version>

        <!-- SonarCloud -->
        <sonar.organization>ifrugal</sonar.organization>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.projectKey>iFrugal_gateway</sonar.projectKey>
        <sonar.java.coveragePlugin>jacoco</sonar.java.coveragePlugin>
        <sonar.coverage.jacoco.xmlReportPaths>
            ${project.basedir}/gateway-core/target/site/jacoco/jacoco.xml
        </sonar.coverage.jacoco.xmlReportPaths>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud BOM -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Internal modules -->
            <dependency>
                <groupId>com.github.ifrugal</groupId>
                <artifactId>gateway-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.ifrugal</groupId>
                <artifactId>gateway-starter</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Third-party libraries -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
                <version>${springdoc-openapi.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.ifrugal</groupId>
                <artifactId>persistence-utils</artifactId>
                <version>${lazydevs.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.ifrugal</groupId>
                <artifactId>app-building-commons</artifactId>
                <version>${lazydevs.version}</version>
            </dependency>
            <dependency>
                <groupId>com.networknt</groupId>
                <artifactId>json-schema-validator</artifactId>
                <version>${json-schema-validator.version}</version>
            </dependency>

            <!-- Lombok — pin so every module gets the JDK-25-compatible
                 version regardless of what Spring Boot's BOM resolves. -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- Java compiler — pin release target locally rather than inheriting
                 from parent. Wire Lombok in explicitly via annotationProcessorPaths
                 so the JDK-25-compatible version is used during compilation. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <release>${java.version}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- JaCoCo Code Coverage.
                 Three executions:
                   - prepare-agent  (binds to initialize): wires the JVM agent
                     into the test classpath so coverage data is collected.
                   - report        (binds to verify): writes target/site/jacoco/
                     for SonarCloud + the CI artifact upload.
                   - check         (binds to verify): fails the build if line
                     coverage drops below ${jacoco.coverage.line.minimum} or
                     branch coverage below ${jacoco.coverage.branch.minimum}.
                     Override per-module by setting <jacoco.skip>true</jacoco.skip>
                     in the child pom — gateway-app does this. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <skip>${jacoco.skip}</skip>
                            <haltOnFailure>true</haltOnFailure>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.coverage.line.minimum}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.coverage.branch.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven-javadoc-plugin.version}</version>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <failOnError>false</failOnError>
                            <additionalJOptions>
                                <additionalJOption>-Xdoclint:none</additionalJOption>
                            </additionalJOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- CycloneDX SBOM.
                 Generates a Software Bill of Materials (CycloneDX schema 1.6)
                 for each module's compile / runtime / provided dependency
                 graph and attaches it as a Maven artifact with classifier
                 `cyclonedx` and extensions .json + .xml. Once attached, the
                 BOM is deployed alongside the jar — every Maven Central
                 release ships an SBOM downstream consumers can feed into
                 Dependency-Track / FOSSA / Snyk / GitHub dependency graph.

                 Test-scope deps are excluded by default; we don't ship them.
                 includeLicenseText=false keeps the BOM compact (license
                 identifiers travel with each component, the full text does
                 not). -->
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>${cyclonedx-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>build-sbom</id>
                        <phase>package</phase>
                        <goals>
                            <goal>makeBom</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <schemaVersion>${cyclonedx.schema.version}</schemaVersion>
                    <projectType>library</projectType>
                    <outputFormat>all</outputFormat>
                    <outputName>${project.artifactId}-${project.version}-cyclonedx</outputName>
                    <includeBomSerialNumber>true</includeBomSerialNumber>
                    <includeCompileScope>true</includeCompileScope>
                    <includeProvidedScope>true</includeProvidedScope>
                    <includeRuntimeScope>true</includeRuntimeScope>
                    <includeSystemScope>false</includeSystemScope>
                    <includeTestScope>false</includeTestScope>
                    <includeLicenseText>false</includeLicenseText>
                </configuration>
            </plugin>
        </plugins>

        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
